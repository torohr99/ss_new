{
  "name": "sportsmack-backend",
  "version": "1.0.0",
  "description": "Backend for SportSmack",
  "main": "server.js",
  "scripts": { 
    "start": "node server.js", 
    "dev": "npx kill-port 5000 && nodemon server.js", 
    "build": "copy prisma\\schema.postgres.prisma prisma\\schema.prisma && npx prisma generate && npx prisma db push", 
    "render-build": "cp prisma/schema.postgres.prisma prisma/schema.prisma && npm install && npx prisma generate && npx prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.10",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0"
  }
}
