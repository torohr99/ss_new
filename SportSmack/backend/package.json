{
  "name": "sportsmack-backend",
  "version": "1.0.0",
  "description": "Backend for SportSmack",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "test:smoke": "node tests/smoke.js",
    "dev": "npx kill-port 5000 && nodemon server.js",
    "build": "copy prisma\\schema.postgres.prisma prisma\\schema.prisma && npx prisma generate",
    "render-build": "npm install && cp prisma/schema.postgres.prisma prisma/schema.prisma && npx prisma migrate deploy && npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "rate-limit-redis": "^6.0.1",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.10",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "winston": "^3.17.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0"
  }
}
