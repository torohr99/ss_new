generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                  @id @default(autoincrement())
  username             String               @unique
  email                String               @unique
  password_hash        String
  profile_pic          String?
  isVerified           Boolean              @default(false)
  verificationToken    String?
  otpCode              String?
  created_at           DateTime             @default(now())
  predictions_total    Int                  @default(0)
  predictions_won      Int                  @default(0)
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  role                 String               @default("USER")
  blockedBy            Block[]              @relation("UserBlockedBy")
  blocksMade           Block[]              @relation("UserBlocks")
  bracketLeagues       BracketLeague[]
  bracketPicks         BracketPick[]        @relation("UserBracketPicks")
  comments             Comment[]
  fantasyLeagues       FantasyLeague[]      @relation("LeagueOwner")
  fantasyTeams         FantasyTeam[]
  friendOf             Friendship[]         @relation("UserFriendOf")
  friends              Friendship[]         @relation("UserFriends")
  chatDisciplines      GameChatDiscipline[]
  gameMessages         GameMessage[]
  likes                Like[]
  notifications        Notification[]
  posts                Post[]
  reportsMade          Report[]             @relation("ReportsMade")
  reportsResolved      Report[]             @relation("ReportsResolved")
  badges               UserBadge[]
  teams                UserTeam[]
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at])
  @@index([user_id, read])
}

model UserBadge {
  id          Int      @id @default(autoincrement())
  user_id     Int
  badge_name  String
  icon        String
  description String
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at])
  @@index([user_id, badge_name])
}

model Friendship {
  id         Int      @id @default(autoincrement())
  user_id    Int
  friend_id  Int
  status     String   @default("PENDING")
  created_at DateTime @default(now())
  friend     User     @relation("UserFriendOf", fields: [friend_id], references: [id])
  user       User     @relation("UserFriends", fields: [user_id], references: [id])

  @@unique([user_id, friend_id])
  @@index([friend_id, status])
  @@index([user_id, status])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id         Int       @id @default(autoincrement())
  reporterId Int
  targetType String
  targetId   String
  reason     String
  details    String?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy Int?
  reporter   User      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver   User?     @relation("ReportsResolved", fields: [resolvedBy], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
}

model Team {
  id           Int        @id @default(autoincrement())
  city         String
  name         String
  logo_url     String
  sport        String
  abbreviation String
  users        UserTeam[]

  @@unique([sport, abbreviation])
}

model UserTeam {
  user_id Int
  team_id Int
  team    Team @relation(fields: [team_id], references: [id])
  user    User @relation(fields: [user_id], references: [id])

  @@id([user_id, team_id])
}

model Post {
  id         Int       @id @default(autoincrement())
  content    String
  image_url  String?
  created_at DateTime  @default(now())
  user_id    Int
  comments   Comment[]
  likes      Like[]
  user       User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([user_id, id])
  @@index([created_at])
}

model Like {
  id         Int      @id @default(autoincrement())
  user_id    Int
  post_id    Int
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
  @@index([post_id])
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  created_at DateTime @default(now())
  user_id    Int
  post_id    Int
  post       Post     @relation(fields: [post_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@index([post_id, created_at])
}

model GameMessage {
  id            Int      @id @default(autoincrement())
  gameId        String
  league        String
  content       String
  type          String   @default("text")
  poll_question String?
  poll_options  String?
  poll_results  String?
  userId        Int
  teamId        Int?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([gameId, createdAt])
  @@index([league, gameId, createdAt])
}

model GameChatDiscipline {
  id          Int      @id @default(autoincrement())
  userId      Int
  league      String
  gameId      String
  yellowCards Int      @default(0)
  redCards    Int      @default(0)
  banned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, league, gameId])
  @@index([league, gameId, banned])
  @@index([userId, createdAt])
}

model FantasyLeague {
  id               Int                  @id @default(autoincrement())
  name             String
  ownerId          Int
  status           String               @default("PREDRAFT")
  currentPickIndex Int                  @default(0)
  createdAt        DateTime             @default(now())
  season           Int
  draftPicks       FantasyDraftPick[]
  owner            User                 @relation("LeagueOwner", fields: [ownerId], references: [id])
  matchups         FantasyMatchup[]
  teams            FantasyTeam[]
  trades           FantasyTrade[]
  transactions     FantasyTransaction[]
  waiverClaims     FantasyWaiverClaim[]

  @@index([ownerId])
  @@index([status, createdAt])
  @@index([status, id])
}

model FantasyTeam {
  id                 Int                  @id @default(autoincrement())
  leagueId           Int
  userId             Int
  name               String
  draftOrder         Int?
  createdAt          DateTime             @default(now())
  faab               Int                  @default(100)
  awayMatchups       FantasyMatchup[]     @relation("AwayMatchups")
  homeMatchups       FantasyMatchup[]     @relation("HomeMatchups")
  league             FantasyLeague        @relation(fields: [leagueId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  players            FantasyTeamPlayer[]
  tradesProposed     FantasyTrade[]       @relation("TradeProposer")
  tradesReceived     FantasyTrade[]       @relation("TradeRecipient")
  tradeItemsSent     FantasyTradeItem[]   @relation("TradeItemsFromTeam")
  tradeItemsReceived FantasyTradeItem[]   @relation("TradeItemsToTeam")
  transactions       FantasyTransaction[]
  waiverClaims       FantasyWaiverClaim[]
  weeklyScores       FantasyWeeklyScore[]

  @@index([leagueId])
  @@index([userId])
}

model FantasyPlayer {
  id              Int                        @id @default(autoincrement())
  espnId          String
  name            String
  position        String
  team            String
  imageUrl        String?
  byeWeek         Int?
  projectedPoints Float?
  jerseyNumber    String?
  lastYearPoints  Float?
  season          Int
  isActive        Boolean                    @default(true)
  lastSeenAt      DateTime?
  draftPicks      FantasyDraftPick[]
  weeklyScores    FantasyPlayerWeeklyScore[]
  teamRosters     FantasyTeamPlayer[]
  tradeItems      FantasyTradeItem[]
  transactions    FantasyTransaction[]
  waiverClaims    FantasyWaiverClaim[]

  @@unique([season, espnId])
  @@index([season, position, name])
  @@index([season, team])
  @@index([season, isActive, position])
  @@index([position, name])
}

model FantasyDraftPick {
  id         Int           @id @default(autoincrement())
  leagueId   Int
  playerId   Int
  teamId     Int
  pickNumber Int
  league     FantasyLeague @relation(fields: [leagueId], references: [id])
  player     FantasyPlayer @relation(fields: [playerId], references: [id])

  @@unique([leagueId, playerId])
  @@unique([leagueId, pickNumber])
  @@index([teamId])
  @@index([playerId])
}

model FantasyTeamPlayer {
  id       Int           @id @default(autoincrement())
  teamId   Int
  playerId Int
  status   String        @default("BENCH")
  player   FantasyPlayer @relation(fields: [playerId], references: [id])
  team     FantasyTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([teamId, status])
  @@index([playerId])
}

model FantasyWeeklyScore {
  id         Int     @id @default(autoincrement())
  teamId     Int
  weekNumber Int
  points     Float   @default(0.0)
  isLive     Boolean @default(true)

  team FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, weekNumber])
  @@index([weekNumber])
  @@index([weekNumber, teamId])
}

model FantasyPlayerWeeklyScore {
  id         Int     @id @default(autoincrement())
  playerId   Int
  weekNumber Int
  points     Float   @default(0)
  isLive     Boolean @default(true)
  statsJson  String?

  player FantasyPlayer @relation(fields: [playerId], references: [id])

  @@unique([playerId, weekNumber])
  @@index([weekNumber])
  @@index([weekNumber, playerId])
}

model BracketLeague {
  id        String        @id @default(uuid())
  name      String
  ownerId   Int
  isPrivate Boolean       @default(true)
  passcode  String?
  createdAt DateTime      @default(now())
  owner     User          @relation(fields: [ownerId], references: [id])
  picks     BracketPick[]
}

model BracketPick {
  id          String        @id @default(uuid())
  leagueId    String
  userId      Int
  bracketData String
  score       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  league      BracketLeague @relation(fields: [leagueId], references: [id])
  user        User          @relation("UserBracketPicks", fields: [userId], references: [id])

  @@index([leagueId])
  @@index([userId])
  @@index([leagueId, userId])
}

model FantasyMatchup {
  id         Int           @id @default(autoincrement())
  leagueId   Int
  weekNumber Int
  homeTeamId Int
  awayTeamId Int
  homeScore  Float         @default(0)
  awayScore  Float         @default(0)
  status     String        @default("UPCOMING")
  awayTeam   FantasyTeam   @relation("AwayMatchups", fields: [awayTeamId], references: [id])
  homeTeam   FantasyTeam   @relation("HomeMatchups", fields: [homeTeamId], references: [id])
  league     FantasyLeague @relation(fields: [leagueId], references: [id])

  @@index([leagueId, weekNumber])
}

model FantasyTransaction {
  id            Int            @id @default(autoincrement())
  leagueId      Int
  teamId        Int
  type          String
  playerId      Int?
  relatedTeamId Int?
  createdAt     DateTime       @default(now())
  league        FantasyLeague  @relation(fields: [leagueId], references: [id])
  player        FantasyPlayer? @relation(fields: [playerId], references: [id])
  team          FantasyTeam    @relation(fields: [teamId], references: [id])

  @@index([leagueId, createdAt])
  @@index([teamId, createdAt])
  @@index([playerId])
}

model FantasyWaiverClaim {
  id        Int           @id @default(autoincrement())
  leagueId  Int
  teamId    Int
  playerId  Int
  bidAmount Int           @default(0)
  priority  Int?
  status    String        @default("PENDING")
  createdAt DateTime      @default(now())
  league    FantasyLeague @relation(fields: [leagueId], references: [id])
  player    FantasyPlayer @relation(fields: [playerId], references: [id])
  team      FantasyTeam   @relation(fields: [teamId], references: [id])

  @@index([leagueId, status])
  @@index([status, leagueId])
  @@index([teamId])
  @@index([playerId])
}

model FantasyTrade {
  id              Int                @id @default(autoincrement())
  leagueId        Int
  proposerTeamId  Int
  recipientTeamId Int
  status          String             @default("PENDING")
  createdAt       DateTime           @default(now())
  respondedAt     DateTime?
  expiresAt       DateTime?
  league          FantasyLeague      @relation(fields: [leagueId], references: [id])
  proposerTeam    FantasyTeam        @relation("TradeProposer", fields: [proposerTeamId], references: [id])
  recipientTeam   FantasyTeam        @relation("TradeRecipient", fields: [recipientTeamId], references: [id])
  items           FantasyTradeItem[]

  @@index([leagueId, status])
  @@index([proposerTeamId])
  @@index([recipientTeamId])
}

model FantasyTradeItem {
  id         Int           @id @default(autoincrement())
  tradeId    Int
  playerId   Int
  fromTeamId Int
  toTeamId   Int
  fromTeam   FantasyTeam   @relation("TradeItemsFromTeam", fields: [fromTeamId], references: [id])
  player     FantasyPlayer @relation(fields: [playerId], references: [id])
  toTeam     FantasyTeam   @relation("TradeItemsToTeam", fields: [toTeamId], references: [id])
  trade      FantasyTrade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([playerId])
  @@index([fromTeamId])
  @@index([toTeamId])
}
