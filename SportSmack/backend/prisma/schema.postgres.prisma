generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password_hash String
  profile_pic   String?
  isVerified    Boolean  @default(false) // Required for new signups
  verificationToken String? // Token used to verify the email
  otpCode       String?
  created_at    DateTime @default(now())

  friends        Friendship[]    @relation("UserFriends")
  friendOf       Friendship[]    @relation("UserFriendOf")
  teams          UserTeam[]
  posts          Post[]
  likes          Like[]
  comments       Comment[]
  gameMessages   GameMessage[]
  fantasyLeagues FantasyLeague[] @relation("LeagueOwner")
  fantasyTeams   FantasyTeam[]

  // Bracket features
  bracketLeagues BracketLeague[]
  bracketPicks   BracketPick[]   @relation("UserBracketPicks")

  // Badges & Notifications
  badges         UserBadge[]
  notifications  Notification[]
  
  // Profile enhancements
  predictions_total Int @default(0)
  predictions_won   Int @default(0)
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String   // "BADGE", "SYSTEM"
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model UserBadge {
  id          Int      @id @default(autoincrement())
  user_id     Int
  badge_name  String
  icon        String
  description String
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model Friendship {
  id         Int      @id @default(autoincrement())
  user_id    Int
  friend_id  Int
  status     String   @default("PENDING") // PENDING or ACCEPTED
  created_at DateTime @default(now())

  user   User @relation("UserFriends", fields: [user_id], references: [id])
  friend User @relation("UserFriendOf", fields: [friend_id], references: [id])

  @@unique([user_id, friend_id])
}

model Team {
  id       Int    @id @default(autoincrement())
  city     String
  name     String
  abbreviation String
  logo_url String
  sport    String

  users UserTeam[]

  @@unique([sport, abbreviation])
}

model UserTeam {
  user_id Int
  team_id Int
  user    User @relation(fields: [user_id], references: [id])
  team    Team @relation(fields: [team_id], references: [id])

  @@id([user_id, team_id])
}

model Post {
  id         Int      @id @default(autoincrement())
  content    String
  image_url  String?
  created_at DateTime @default(now())

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  likes    Like[]
  comments Comment[]

  @@index([user_id])
  @@index([created_at])
}

model Like {
  id         Int      @id @default(autoincrement())
  user_id    Int
  post_id    Int
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  @@unique([user_id, post_id])
  @@index([post_id])
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  created_at DateTime @default(now())

  user_id Int
  post_id Int
  user    User @relation(fields: [user_id], references: [id])
  post    Post @relation(fields: [post_id], references: [id])

  @@index([post_id])
}

model GameMessage {
  id        Int      @id @default(autoincrement())
  gameId    String
  league    String
  content   String
  type      String   @default("text") // 'text', 'poll', 'meme'
  poll_question String?
  poll_options  String? // JSON string
  poll_results  String? // JSON string
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  teamId    Int? // EspnId of the team the user supports, if any
  createdAt DateTime @default(now())

  @@index([gameId])
}

// =======================
// FANTASY FOOTBALL
// =======================

model FantasyLeague {
  id               Int      @id @default(autoincrement())
  name             String
  ownerId          Int
  status           String   @default("PREDRAFT") // PREDRAFT, DRAFTING, SEASON, FINISHED
  currentPickIndex Int      @default(0)
  createdAt        DateTime @default(now())

  owner      User               @relation("LeagueOwner", fields: [ownerId], references: [id])
  teams      FantasyTeam[]
  draftPicks FantasyDraftPick[]
  matchups      FantasyMatchup[]
  transactions  FantasyTransaction[]
}

model FantasyTeam {
  id         Int      @id @default(autoincrement())
  leagueId   Int
  userId     Int
  name       String
  draftOrder Int?
  createdAt  DateTime @default(now())

  league       FantasyLeague        @relation(fields: [leagueId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
  players      FantasyTeamPlayer[]
  weeklyScores FantasyWeeklyScore[]
  homeMatchups FantasyMatchup[] @relation("HomeMatchups")
  awayMatchups FantasyMatchup[] @relation("AwayMatchups")
  transactions FantasyTransaction[]

  @@index([leagueId])
  @@index([userId])
}

model FantasyPlayer {
  id       Int     @id @default(autoincrement())
  espnId   String  @unique
  name     String
  position String
  team     String
  imageUrl String?
  byeWeek        Int?
  projectedPoints Float?

  draftPicks  FantasyDraftPick[]
  teamRosters FantasyTeamPlayer[]
  transactions FantasyTransaction[]
}

model FantasyDraftPick {
  id         Int @id @default(autoincrement())
  leagueId   Int
  playerId   Int
  teamId     Int
  pickNumber Int

  league FantasyLeague @relation(fields: [leagueId], references: [id])
  player FantasyPlayer @relation(fields: [playerId], references: [id])

  @@index([leagueId])
}

model FantasyTeamPlayer {
  id       Int    @id @default(autoincrement())
  teamId   Int
  playerId Int
  status   String @default("BENCH") // STARTER, BENCH

  team   FantasyTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player FantasyPlayer @relation(fields: [playerId], references: [id])

  @@index([teamId])
}

model FantasyWeeklyScore {
  id         Int     @id @default(autoincrement())
  teamId     Int
  weekNumber Int
  points     Float   @default(0.0)
  isLive     Boolean @default(true)

  team FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, weekNumber])
}

model BracketLeague {
  id        String   @id @default(uuid())
  name      String
  ownerId   Int
  isPrivate Boolean  @default(true)
  passcode  String?
  createdAt DateTime @default(now())

  owner User          @relation(fields: [ownerId], references: [id])
  picks BracketPick[]
}

model BracketPick {
  id          String   @id @default(uuid())
  leagueId    String
  userId      Int
  bracketData String // JSON string storing the 64-team bracket picks
  score       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league BracketLeague @relation(fields: [leagueId], references: [id])
  user   User          @relation("UserBracketPicks", fields: [userId], references: [id])
}

model FantasyMatchup {
  id              Int      @id @default(autoincrement())
  leagueId        Int
  weekNumber      Int
  homeTeamId      Int
  awayTeamId      Int
  homeScore       Float    @default(0)
  awayScore       Float    @default(0)
  status          String   @default("UPCOMING")

  league   FantasyLeague @relation(fields: [leagueId], references: [id])
  homeTeam FantasyTeam   @relation("HomeMatchups", fields: [homeTeamId], references: [id])
  awayTeam FantasyTeam   @relation("AwayMatchups", fields: [awayTeamId], references: [id])

  @@index([leagueId, weekNumber])
}

model FantasyTransaction {
  id         Int      @id @default(autoincrement())
  leagueId   Int
  teamId     Int
  type       String
  playerId   Int?
  relatedTeamId Int?
  createdAt  DateTime @default(now())

  league FantasyLeague @relation(fields: [leagueId], references: [id])
  team   FantasyTeam   @relation(fields: [teamId], references: [id])
  player FantasyPlayer? @relation(fields: [playerId], references: [id])

  @@index([leagueId])
  @@index([teamId])
}
